#!/usr/bin/env python3
"""stac.publish: write a collection and its items as static JSON under `dest`.

Each item goes to <dest>/<collection>/<item-id>.json, replacing an older copy,
with its `collection` set and links to the collection. Then
<dest>/<collection>/items.json is rebuilt as a GeoJSON FeatureCollection of
every item in that directory, and <dest>/<collection>/collection.json as a
STAC 1.0 collection whose extent covers those items. `dest` is a local path or
file:// URI; other backends (S3, pgSTAC) are not supported yet. Items are read
from local paths or file:// URIs. Writes `published` to /work/outputs.json.
"""

import json
import os
import re
import sys
import tempfile
from pathlib import Path
from typing import Any, NoReturn

WORK = Path(os.environ.get("GLOW_WORK_DIR", "/work"))
INDEX = "items.json"
COLLECTION = "collection.json"
STAC_VERSION = "1.0.0"
WHOLE_WORLD = [-180.0, -90.0, 180.0, 90.0]
# Ids become file and directory names, so they must not contain '/' or '..'.
SAFE_ID = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,254}$")


def fail(message: str) -> NoReturn:
    sys.exit(f"stac.publish: {message}")


def local_path(uri: str, what: str) -> Path:
    if "://" in uri and not uri.startswith("file://"):
        fail(f"{what} {uri!r} is not a local path or file:// URI")
    return Path(uri.removeprefix("file://"))


def item_uri(value: Any) -> str:
    """An item is a path or URI, or a resolved file `{uri, ...}`."""
    if isinstance(value, dict):
        value = value.get("uri")
    if not isinstance(value, str) or not value:
        fail(f"item {value!r} is not a file reference")
    return value


def read_item(value: Any) -> dict[str, Any]:
    uri = item_uri(value)
    try:
        item = json.loads(local_path(uri, "item").read_text())
    except (OSError, json.JSONDecodeError) as exc:
        fail(f"cannot read item {uri!r}: {exc}")
    if not isinstance(item, dict) or item.get("type") != "Feature":
        fail(f"{uri!r} is not a STAC item")
    item_id = item.get("id")
    if not isinstance(item_id, str) or not SAFE_ID.match(item_id):
        fail(f"{uri!r} has an unsafe item id {item_id!r}")
    return item


def write_json(path: Path, document: Any) -> None:
    """Write through a temporary file so readers never see a partial file."""
    with tempfile.NamedTemporaryFile("w", dir=path.parent, delete=False, suffix=".tmp") as tmp:
        json.dump(document, tmp, indent=2)
    # NamedTemporaryFile creates the file 0600; published files are meant to be read.
    os.chmod(tmp.name, 0o644)
    os.replace(tmp.name, path)


def link(rel: str, href: str, media_type: str = "application/json") -> dict[str, str]:
    return {"rel": rel, "href": href, "type": media_type}


def with_collection(item: dict[str, Any], collection: str) -> dict[str, Any]:
    """The item in `collection`, with root, parent and collection links."""
    links = [
        entry
        for entry in item.get("links") or []
        if entry.get("rel") not in ("root", "parent", "collection")
    ]
    links += [link(rel, f"./{COLLECTION}") for rel in ("root", "parent", "collection")]
    return {**item, "collection": collection, "links": links}


def published_items(directory: Path) -> list[dict[str, Any]]:
    return [
        json.loads(path.read_text())
        for path in sorted(directory.glob("*.json"))
        if path.name not in (INDEX, COLLECTION)
    ]


def spatial_extent(items: list[dict[str, Any]]) -> list[float]:
    boxes = [item["bbox"] for item in items if isinstance(item.get("bbox"), list)]
    if not boxes:
        return WHOLE_WORLD
    # The 2D part of each bbox; a 3D bbox is [west, south, low, east, north, high].
    flat = [box if len(box) == 4 else [box[0], box[1], box[3], box[4]] for box in boxes]
    return [
        min(box[0] for box in flat),
        min(box[1] for box in flat),
        max(box[2] for box in flat),
        max(box[3] for box in flat),
    ]


def temporal_extent(items: list[dict[str, Any]]) -> list[str | None]:
    times = sorted(
        value
        for item in items
        for key in ("datetime", "start_datetime", "end_datetime")
        if isinstance(value := (item.get("properties") or {}).get(key), str)
    )
    # RFC 3339 strings in UTC sort in time order.
    return [times[0], times[-1]] if times else [None, None]


def collection_document(
    collection: str, inputs: dict[str, Any], items: list[dict[str, Any]]
) -> dict[str, Any]:
    document: dict[str, Any] = {
        "type": "Collection",
        "stac_version": STAC_VERSION,
        "stac_extensions": [],
        "id": collection,
        "description": inputs.get("description") or f"Items of the {collection} collection.",
        "license": inputs.get("license", "proprietary"),
        "extent": {
            "spatial": {"bbox": [spatial_extent(items)]},
            "temporal": {"interval": [temporal_extent(items)]},
        },
        "links": [
            link("root", f"./{COLLECTION}"),
            *(link("item", f"./{item['id']}.json", "application/geo+json") for item in items),
        ],
    }
    if inputs.get("title"):
        document["title"] = inputs["title"]
    return document


def rebuild(directory: Path, collection: str, inputs: dict[str, Any]) -> None:
    items = published_items(directory)
    write_json(directory / INDEX, {"type": "FeatureCollection", "features": items})
    write_json(directory / COLLECTION, collection_document(collection, inputs, items))


def main() -> None:
    inputs = json.loads((WORK / "inputs.json").read_text())
    collection = inputs["collection"]
    if not isinstance(collection, str) or not SAFE_ID.match(collection):
        fail(f"invalid collection id {collection!r}")
    items = [read_item(value) for value in inputs["items"]]
    ids = [item["id"] for item in items]
    duplicates = sorted({item_id for item_id in ids if ids.count(item_id) > 1})
    if duplicates:
        fail(f"duplicate item ids: {', '.join(duplicates)}")
    for reserved in (INDEX, COLLECTION):
        if reserved.removesuffix(".json") in ids:
            fail(f"item id {reserved.removesuffix('.json')!r} would replace {reserved}")
    directory = local_path(inputs["dest"], "dest") / collection
    directory.mkdir(parents=True, exist_ok=True)
    for item in items:
        write_json(directory / f"{item['id']}.json", with_collection(item, collection))
    rebuild(directory, collection, inputs)
    (WORK / "outputs.json").write_text(json.dumps({"published": len(items)}))


if __name__ == "__main__":
    main()
