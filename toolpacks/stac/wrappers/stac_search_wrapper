#!/usr/bin/env python3
"""stac.search: search a STAC API with POST /search.

Follows `next` links until the API has no more pages or `max_items` items
are found. Each item is reduced to its id, collection, datetime, bbox,
properties and assets, and an asset to its href, type, roles and title.
`assets` keeps only the named asset keys. Writes `items` and `count` to
/work/outputs.json. See docs/toolpacks.md for the tool contract.
"""

import json
import os
import sys
import urllib.error
import urllib.request
from pathlib import Path
from typing import Any, NoReturn

WORK = Path(os.environ.get("GLOW_WORK_DIR", "/work"))
DEFAULT_API = "https://earth-search.aws.element84.com/v1"
PAGE_SIZE = 100
TIMEOUT = 60
ASSET_FIELDS = ("href", "type", "roles", "title")


def fail(message: str) -> NoReturn:
    sys.exit(f"stac.search: {message}")


def post(url: str, body: dict[str, Any]) -> dict[str, Any]:
    if not url.startswith("https://"):
        fail(f"{url!r} is not an https:// URL")
    request = urllib.request.Request(
        url,
        data=json.dumps(body).encode(),
        headers={"Content-Type": "application/json", "Accept": "application/geo+json"},
        method="POST",
    )
    try:
        with urllib.request.urlopen(request, timeout=TIMEOUT) as response:
            return json.load(response)
    except urllib.error.HTTPError as exc:
        detail = exc.read(2000).decode(errors="replace")
        fail(f"{url} returned HTTP {exc.code}: {detail}")
    except (urllib.error.URLError, TimeoutError, json.JSONDecodeError) as exc:
        fail(f"cannot search {url}: {exc}")


def next_page(page: dict[str, Any], url: str) -> tuple[str, dict[str, Any]] | None:
    """The URL and body of the next page, from a POST `next` link."""
    for link in page.get("links") or []:
        if link.get("rel") != "next":
            continue
        if link.get("method", "GET") != "POST" or not isinstance(link.get("body"), dict):
            fail("the API pages with GET links; only POST paging is supported")
        return link.get("href") or url, link["body"]
    return None


def summary(feature: dict[str, Any], keep: set[str] | None) -> dict[str, Any]:
    properties = feature.get("properties") or {}
    assets = {
        key: {field: asset[field] for field in ASSET_FIELDS if field in asset}
        for key, asset in (feature.get("assets") or {}).items()
        if keep is None or key in keep
    }
    return {
        "id": feature.get("id"),
        "collection": feature.get("collection"),
        "datetime": properties.get("datetime"),
        "bbox": feature.get("bbox"),
        "properties": properties,
        "assets": assets,
    }


def main() -> None:
    inputs = json.loads((WORK / "inputs.json").read_text())
    api = inputs.get("api", DEFAULT_API).rstrip("/")
    max_items = inputs.get("max_items", 100)
    if not isinstance(max_items, int) or max_items < 1:
        fail(f"max_items must be a positive integer, not {max_items!r}")
    keep = set(inputs["assets"]) if inputs.get("assets") is not None else None
    body: dict[str, Any] = {
        "collections": inputs["collections"],
        "limit": min(PAGE_SIZE, max_items),
    }
    for key in ("bbox", "datetime", "query"):
        if inputs.get(key) is not None:
            body[key] = inputs[key]

    url = f"{api}/search"
    items: list[dict[str, Any]] = []
    while len(items) < max_items:
        page = post(url, body)
        features = page.get("features")
        if not isinstance(features, list):
            fail(f"{url} did not return a FeatureCollection")
        items += [summary(feature, keep) for feature in features]
        following = next_page(page, url)
        if not features or following is None:
            break
        url, body = following
    items = items[:max_items]
    missing = sorted({key for item in items for key in keep or () if key not in item["assets"]})
    if missing:
        fail(f"some items have no asset named: {', '.join(missing)}")
    (WORK / "outputs.json").write_text(json.dumps({"items": items, "count": len(items)}))


if __name__ == "__main__":
    main()
